# Copy to site.env (gitignored) and edit. The shell scripts source it when
# present; every value can also be set in the environment, which wins.

# ssh host that holds the source films (batch_encode.sh). When NAS_LAN is set
# and accepts a non-interactive ssh login it is preferred (an ssh-config alias
# is fine), e.g. a LAN alias for the same box.
#NAS=${NAS:-nas}
#NAS_LAN=${NAS_LAN:-nas-lan}

# File that defines OMLX_API_KEY for the vision pass (full_pipeline.sh,
# repair_pass.sh, repair_all.sh). Not needed if OMLX_API_KEY is already set.
#CRV_ENV_FILE=${CRV_ENV_FILE:-$HOME/.config/crv/secrets.env}

# repair_all.sh: the oMLX server that takes images, and where packages live.
#VLM_HOST=${VLM_HOST:-localhost}
#CRV_MEDIA=${CRV_MEDIA:-$HOME/crv/shared-media}
#CRV_REDO=${CRV_REDO:-$HOME/crv/crv-redo}
